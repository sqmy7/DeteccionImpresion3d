# --- Postgres ---
POSTGRES_USER=printwatch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=printwatch

# --- Backend / Inference worker ---
# Usar "localhost" si backend/worker corren nativos en Windows (modo dev, Camino A: sin Docker).
# docker-compose.yml sobreescribe estas dos variables a "postgres"/"redis" automaticamente
# cuando corres los servicios con --profile full (contenedores hablando entre si).
DATABASE_URL=postgresql+asyncpg://printwatch:changeme@localhost:5432/printwatch
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# LAN local: "*" esta bien para desarrollo. Restringir a origenes concretos si se expone mas alla de la LAN.
CORS_ALLOW_ORIGINS=*

# Resolucion que pide capture a las camaras USB (la C922 acepta hasta 1920x1080; el modelo trabaja a 640x640).
# USB_FRAME_WIDTH=1280
# USB_FRAME_HEIGHT=720

# Pausa automatica por spaghetti (3 capas seguidas):
#   on   = avisa, cuenta 15 s y envia la pausa a la impresora (comportamiento por defecto)
#   warn = avisa y registra el evento "auto_pause.would_pause" en la bitacora, pero NO envia la pausa
#   off  = no hace nada
# Un valor distinto de estos tres impide que el backend arranque. Cambiarlo exige reconstruir/reiniciar el backend.
# AUTO_PAUSE_MODE=on

# Incidentes (docs/META_FINAL.md): una deteccion suelta abre un incidente solo si su clase esta en esta lista y su
# confianza llega al minimo; a lo sumo uno por clase y trabajo. stringing y blob_over_extrusion son cosmeticos y no abren.
# INCIDENT_CLASSES=spaghetti,layer_shift
# INCIDENT_MIN_CONFIDENCE=0.50
